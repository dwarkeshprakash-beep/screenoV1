# backend/.env.example
# Copy to .env and fill in the real values before running the server.
# Never commit .env — it is in .gitignore.

PORT=4000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Which backend to use. Currently only 'supabase' is supported.
DB_TYPE=supabase

# Supabase (current) — use the transaction pooler URL (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# SQL Server (future — set DB_TYPE=sqlserver to activate)
# DB_SERVER=localhost
# DB_DATABASE=Screeno
# DB_USER=screeno_user
# DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
AUTH_RATE_LIMIT_MAX=30

# Leave COOKIE_SECURE blank to auto-detect Render/HTTPS. Set true explicitly in production
# if your hosting environment does not identify itself or forward the original protocol.
COOKIE_SECURE=
COOKIE_SAMESITE=lax

# ── AI services (all free tiers work) ────────────────────────────────────────
GROQ_API_KEY=          # console.groq.com — used for LLM + Whisper STT
GEMINI_API_KEY=        # aistudio.google.com — fallback LLM

# ── File storage (Supabase Storage) ──────────────────────────────────────────
# Bucket "files" must exist with folders resumes/ and reports/ (public access)
SUPABASE_URL=          # https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # Settings > API > service_role key (keep secret)

# ── Video (LiveKit) ───────────────────────────────────────────────────────────
# Only needed if human-interview video rooms are used (currently paused in V2)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Email (SMTP via Brevo or any SMTP provider) ───────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=             # your Brevo login email
SMTP_PASSWORD=         # Brevo SMTP key (NOT your account password)
MAIL_FROM_NAME=Screeno
MAIL_FROM_EMAIL=       # must be a verified sender in Brevo

# Optional Gmail Apps Script transport used only for forgot-password emails.
# Deploy integrations/google-apps-script/password-reset.gs as a web app, then set
# the deployment URL and the same random secret in Apps Script Project Properties.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Optional: comma-separated list of override addresses for staging/testing.
# When set, ALL outbound emails go here instead of the real recipients.
# EMAIL_REDIRECT_TO=dev@yourcompany.com

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
